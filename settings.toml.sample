# Weathervane Config file
[general]
logging = "DEBUG"

[mqtt]
host = 10.10.10.10
user = Username
pass = password
topic = esp_home/1/weather
# The credentials for your MQTT server
port = 1883
[location]
# Your location in Lat/Long. (There are a number of resources to figure this out, probably
# does not need to be more than a couple of decimal points.)
longitude = -123.00
latitude = 32.00

[weather]
contact = jrconlin@example.com
useragent = Weathervane/{ID}
url = https://api.weather.gov
ID = 425c95b4-dadf-dead-beef-536decafbad
# weather.gov's API needs a unique user agent string and optional Contact info.
# Eventually, they may assign a unique API key, but it's all open for now.
# See https://www.weather.gov/documentation/services-web-api
feature-flags = []
